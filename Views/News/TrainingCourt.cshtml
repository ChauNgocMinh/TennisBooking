@{
    ViewData["Title"] = "Sân tập";
}
<section class="page-hero"><div class="container"><p class="page-hero-eyebrow" data-i18n="news.eyebrow">TIN TỨC</p><h1 data-i18n="news.trainingTitle">Sân tập</h1><p data-i18n="news.trainingDescription">Không gian luyện tập chất lượng cho từng buổi học.</p></div></section>
<main class="container content-section"><div class="news-grid"><article class="news-card"><div class="news-card-icon">🎾</div><h2 data-i18n="news.trainingCard">Sân tập chuẩn thi đấu</h2><p data-i18n="news.trainingText">Mặt sân được chăm sóc định kỳ để mang lại trải nghiệm ổn định.</p></article></div></main>
<style>.news-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }.news-card { padding: clamp(22px, 4vw, 34px); background: #fff; border: 1px solid #e5e9ed; border-radius: 18px; box-shadow: 0 14px 40px rgba(25,39,52,.07); }.news-card h2 { margin: 0 0 22px; font-size: 1.35rem; }.news-card-icon { margin-bottom: 18px; font-size: 2rem; }@@media (max-width: 768px) { .news-grid { grid-template-columns: 1fr; } }</style>
