@{
    ViewData["Title"] = "Home Page";
}

@model TennisBooking.ViewModels.HomeViewModel

<section class="hero-banner">
    <!-- Background Video -->
    <video class="hero-video"
           autoplay
           muted
           loop
           playsinline>
        <source src="~/Media/Videos/Banner.mp4" type="video/mp4" />
    </video>

    <div class="hero-overlay"></div>

    <div class="hero-content container">
        <h1 class="hero-title">
            <span data-i18n="home.title">CHÀO MỪNG ĐẾN HỌC VIỆN ACE TENNIS</span>
        </h1>

        <h2 class="hero-subtitle">
            <span data-i18n="home.subtitle">Huấn luyện tennis chuyên nghiệp tại TP.HCM</span>
        </h2>

        <div class="hero-customers">
            <span class="customer-number"
                  data-target="500">
                0
            </span>
            <span class="customer-plus">+</span>

            <div class="customer-label">
                <span data-i18n="home.customers">Khách hàng đã tin tưởng</span>
            </div>
        </div>

        <button type="button"
                class="btn btn-warning btn-lg hero-booking-btn"
                data-scroll-to="#schedule-section">
            <span data-i18n="home.bookNow">Đặt lịch ngay</span>
        </button>
    </div>
</section>

<div class="modal fade" id="weeklyBookingModal" tabindex="-1" aria-labelledby="weeklyBookingModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content weekly-booking-modal">
            <div class="modal-header">
                <h2 class="modal-title" id="weeklyBookingModalTitle" data-i18n="booking.weeklyTitle">Đặt lịch</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <form id="weeklyBookingForm">
                <div class="modal-body">
                    <p class="weekly-booking-description" data-i18n="booking.weeklyDescription">Điền thông tin để đăng ký lịch học trong tuần.</p>
                    <div class="weekly-booking-fields">
                        <label>
                            <span data-i18n="booking.name">Họ và tên</span>
                            <input id="weeklyBookingName" name="name" type="text" autocomplete="name" required placeholder="Nguyễn Văn A" />
                        </label>
                        <label>
                            <span data-i18n="booking.phone">Số điện thoại</span>
                            <input id="weeklyBookingPhone" name="phone" type="tel" autocomplete="tel" required placeholder="0900 000 000" />
                        </label>
                    </div>
                    <fieldset class="weekly-days-fieldset">
                        <legend data-i18n="booking.weeklyGroup">Đặt cho cả tuần</legend>
                        <div id="bookingWeekOptions" class="booking-week-options"></div>
                    </fieldset>
                    <div id="weeklyBookingError" class="alert alert-danger d-none mb-3" role="alert"></div>
                    <div id="weeklyBookingSuccess" class="alert alert-success d-none mb-0" role="status" data-i18n="booking.weeklySuccess">Thông tin của bạn đã được ghi nhận.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal" data-i18n="booking.cancel">Hủy</button>
                    <button id="weeklyBookingSubmit" type="submit" class="btn btn-warning" disabled data-i18n="booking.submit">Gửi yêu cầu đặt sân</button>
                </div>
            </form>
        </div>
    </div>
</div>

<section class="home-about-section">
    <div class="container home-about-grid">
        <div class="home-about-image">
            <img src="~/media/team-coach.jpg" alt="" loading="lazy" />
        </div>
        <div class="home-about-copy">
            <h2 data-i18n="home.aboutTitle">Một đội ngũ đáng tin cậy cho hành trình tennis của bạn</h2>
            <p data-i18n="home.aboutText">ACE Tennis Academy được xây dựng với mong muốn đưa việc học tennis trở nên rõ ràng, gần gũi và bền vững hơn cho mọi trình độ. Chúng tôi tin rằng tennis không chỉ là một môn thể thao, mà còn là hành trình rèn luyện sức khỏe, sự kiên trì, khả năng tập trung và tinh thần vượt qua giới hạn của chính mình.</p>
            <div class="home-about-stats">
                <div><strong data-i18n="home.yearsValue">Nhiều năm</strong><span data-i18n="home.yearsLabel">đồng hành cùng tennis</span></div>
                <div><strong data-i18n="home.customersValue">500+</strong><span data-i18n="home.customersLabel">học viên đã tin tưởng</span></div>
                <div><strong data-i18n="home.trustValue">4.9/5</strong><span data-i18n="home.trustLabel">mức độ tin cậy từ học viên</span></div>
            </div>
            <a class="home-section-link" asp-controller="Home" asp-action="About" data-i18n="home.aboutLink">Tìm hiểu về ACE</a>
        </div>
    </div>
</section>

<section id="schedule-section" class="schedule-section container" aria-labelledby="schedule-title">
    <div class="schedule-header">
        <div>
            <h2 id="schedule-title" data-i18n="schedule.title">Chọn khung giờ học</h2>
            <p class="schedule-description" data-i18n="schedule.description">Chọn giờ bắt đầu và giờ kết thúc để xem khoảng thời gian bạn muốn đăng ký.</p>
        </div>

        <div class="schedule-filters" aria-label="Bộ lọc lịch học">
            <label>
                <span data-i18n="schedule.date">Ngày học</span>
                <input id="schedule-date" type="date" />
            </label>
            <label>
                <span data-i18n="schedule.classType">Loại lớp</span>
                <select id="schedule-class">
                    <option value="private" data-i18n="schedule.private">Lớp cá nhân</option>
                    <option value="group" data-i18n="schedule.group">Lớp nhóm</option>
                    <option value="kids" data-i18n="schedule.kids">Lớp trẻ em</option>
                </select>
            </label>
        </div>
    </div>

    <div class="schedule-card">
        <div class="schedule-card-heading">
            <div>
                <span class="schedule-selected-label" data-i18n="schedule.selected">Khung giờ đã chọn</span>
                <strong id="schedule-selection" data-i18n="schedule.none">Chưa chọn giờ</strong>
            </div>
            <div class="schedule-actions">
                <span id="schedule-status" class="schedule-status" data-i18n="schedule.start">Chọn giờ bắt đầu</span>
                <button type="button"
                        class="btn btn-warning schedule-booking-btn"
                        id="schedule-booking-btn"
                        data-bs-toggle="modal"
                        data-bs-target="#weeklyBookingModal"
                        disabled
                        data-i18n="home.bookNow">
                    Đặt lịch
                </button>
            </div>
        </div>

        <div id="schedule-hours" class="schedule-hours" role="group" aria-label="Các khung giờ từ 8 giờ đến 22 giờ">
            @for (var hour = 8; hour <= 22; hour++)
            {
                <button type="button" class="schedule-hour" data-hour="@hour" aria-pressed="false">
                    <span>@hour.ToString("00"):00</span>
                </button>
            }
        </div>

        <p class="schedule-note" data-i18n="schedule.note">Giờ hoạt động: 08:00–22:00 · Mỗi lần chọn cách nhau 1 giờ</p>
    </div>
</section>

<section class="home-news-section" aria-labelledby="home-news-title">
    <div class="container">
        <div class="home-section-heading">
            <div>
                <h2 id="home-news-title" data-i18n="home.newsTitle">Tin mới nhất</h2>
            </div>
            <a class="home-section-link" asp-controller="News" asp-action="Index" data-i18n="home.newsLink">Xem tất cả</a>
        </div>
        <div class="home-news-grid">
            @foreach (var item in Model.LatestNews)
            {
                <article class="home-news-card">
                    <a class="home-news-image" asp-controller="News" asp-action="Details" asp-route-id="@item.Id">
                        <img src="@item.BannerImageUrl" alt="" loading="lazy" onerror="this.onerror=null;this.src='/media/Logo.png';" />
                    </a>
                    <div class="home-news-card-body">
                        <a class="home-news-title" asp-controller="News" asp-action="Details" asp-route-id="@item.Id">
                            <h3 data-news-title-vi="@item.TitleVi" data-news-title-en="@item.TitleEn"></h3>
                        </a>
                        <time datetime="@item.PublishedAt.ToString("yyyy-MM-dd")">@item.PublishedAt.ToString("dd/MM/yyyy")</time>
                        <p data-news-content-vi="@item.ShortContentVi" data-news-content-en="@item.ShortContentEn"></p>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<style>
    .hero-banner { position: relative; display: flex; align-items: center; width: 100%; height: 100vh; height: 100svh; height: 100dvh; min-height: 100vh; min-height: 100svh; overflow: hidden; }
    .hero-video { position: absolute; top: 50%; left: 50%; z-index: 1; width: 100%; height: 100%; object-fit: cover; transform: translate(-50%, -50%); }
    .hero-overlay { position: absolute; z-index: 2; inset: 0; background: rgba(0, 0, 0, 0.5); }
    .hero-content { position: relative; z-index: 3; display: flex; flex-direction: column; align-items: flex-end; width: 100%; padding: 20px; color: #fff; text-align: right; }
    .hero-title, .hero-subtitle, .hero-customers, .hero-booking-btn { opacity: 0; transform: translateY(30px); animation: heroSlideUp .7s ease-out forwards; }
    .hero-title { margin-bottom: 20px; font-size: clamp(2.2rem, 5vw, 4.5rem); font-weight: 800; line-height: 1.1; letter-spacing: 1px; text-transform: uppercase; animation-delay: 0.95s; }
    .hero-subtitle { margin-bottom: 20px; font-size: clamp(1.2rem, 2.5vw, 2rem); font-weight: 400; animation-delay:1.15s; }
    .hero-customers { display: flex; flex-wrap: wrap; justify-content: flex-end; align-items: baseline; margin-bottom: 30px; animation-delay: 1.35s; }
    .customer-number { font-size: clamp(2.2rem, 4vw, 3.8rem); font-weight: 800; line-height: 1; }
    .customer-plus { margin-left: 3px; color: #ffc107; font-size: clamp(1.8rem, 3vw, 2.8rem); font-weight: 800; line-height: 1; }
    .customer-label { flex-basis: 100%; margin-top: 8px; font-size: 1rem; line-height: 1.4; opacity: .9; }
    .hero-booking-btn { padding: 12px 32px; font-size: 1.1rem; font-weight: 600; border-radius: 6px; animation-delay: 1.75s; }
    .weekly-booking-modal { border: 0; border-radius: 18px; overflow: hidden; box-shadow: 0 24px 70px rgba(16,42,67,.22); }
    .weekly-booking-modal .modal-header { padding: 24px 28px 18px; border-bottom: 1px solid #edf0f2; }
    .weekly-booking-modal .modal-title { color: #17202a; font-size: 1.45rem; font-weight: 700; }
    .weekly-booking-modal .modal-body { padding: 22px 28px 10px; }
    .weekly-booking-description { margin: 0 0 20px; color: #68727d; }
    .weekly-booking-fields { display: grid; gap: 15px; }
    .weekly-booking-fields label { display: grid; gap: 7px; color: #56616c; font-size: .86rem; font-weight: 600; }
    .weekly-booking-fields input { width: 100%; padding: 11px 12px; color: #26313b; border: 1px solid #d9e0e6; border-radius: 8px; font: inherit; font-weight: 400; }
    .weekly-days-fieldset { margin: 22px 0 10px; padding: 16px; border: 1px solid #e5e9ed; border-radius: 12px; }
    .weekly-days-fieldset legend { float: none; width: auto; margin: 0 0 12px; padding: 0 6px; color: #17202a; font-size: .95rem; font-weight: 700; }
    .booking-week-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 9px; }
    .booking-week-option { display: flex; align-items: center; gap: 8px; padding: 9px 10px; color: #4f5a65; background: #f7f8f9; border-radius: 8px; font-size: .86rem; cursor: pointer; }
    .booking-week-option:has(input:checked) { color: #146c43; background: #e9f7ef; }
    .booking-week-option.is-disabled { color: #a5adb5; background: #f1f2f3; cursor: not-allowed; }
    .booking-week-option input { accent-color: #198754; }
    .weekly-booking-modal .modal-footer { padding: 14px 28px 24px; border-top: 0; }
    @@keyframes heroSlideUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }

    .schedule-section {
        padding-top: 72px;
        padding-bottom: 80px;
    }
    .schedule-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; margin-bottom: 28px; }
    .schedule-eyebrow { margin: 0 0 8px; color: #b8860b; font-size: .78rem; font-weight: 700; letter-spacing: .16em; }
    .schedule-header h2 { margin: 0; color: #17202a; font-size: clamp(1.65rem, 3vw, 2.35rem); font-weight: 700; line-height: 1.18; letter-spacing: -.025em; }
    .schedule-description { max-width: 560px; margin: 10px 0 0; color: #68727d; }
    .schedule-filters { display: flex; flex-wrap: wrap; gap: 12px; }
    .schedule-filters label { display: grid; gap: 6px; color: #5e6873; font-size: .78rem; font-weight: 600; }
    .schedule-filters input, .schedule-filters select { min-width: 164px; padding: 10px 12px; color: #26313b; background: #fff; border: 1px solid #d9e0e6; border-radius: 8px; }
    .schedule-card { padding: clamp(20px, 4vw, 32px); background: #fff; border: 1px solid #e5e9ed; border-radius: 18px; box-shadow: 0 14px 40px rgba(25,39,52,.08); }
    .schedule-card-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 24px; }
    .schedule-actions { display: flex; align-items: center; gap: 12px; }
    .schedule-booking-btn { font-weight: 600; white-space: nowrap; }
    .schedule-booking-btn:disabled, #weeklyBookingSubmit:disabled { cursor: not-allowed; opacity: .55; }
    .schedule-selected-label { display: block; margin-bottom: 4px; color: #7a858f; font-size: .8rem; }
    .schedule-card-heading strong { color: #17202a; font-size: 1.15rem; }
    .schedule-status { padding: 7px 12px; color: #66717b; background: #f3f5f7; border-radius: 999px; font-size: .82rem; }
    .schedule-hours { display: grid; grid-template-columns: repeat(15, minmax(58px, 1fr)); gap: 8px; overflow-x: auto; padding-bottom: 4px; }
    .schedule-hour { min-width: 58px; padding: 15px 8px; color: #4f5a65; background: #f7f8f9; border: 1px solid #e5e9ed; border-radius: 10px; cursor: pointer; font-size: .82rem; transition: 0.75s; }
    .schedule-hour:hover, .schedule-hour:focus-visible { color: #7d5b00; border-color: #e5b82e; outline: none; transform: translateY(-2px); }
    .schedule-hour.is-booked, .schedule-hour.is-booked:disabled { color: #a5adb5; background: #eceff1; border-color: #d9dee2; cursor: not-allowed; opacity: .75; transform: none; }
    .schedule-hour.is-start, .schedule-hour.is-end, .schedule-hour.is-selected { color: #fff; background: #198754; border-color: #198754; }
    .schedule-hour.is-start, .schedule-hour.is-end { box-shadow: 0 5px 14px rgba(25,135,84,.25); }
    .schedule-note { margin: 16px 0 0; color: #89939c; font-size: .82rem; }
    @@media (max-width: 768px) {
        .hero-content { padding: 20px 16px; }
        .hero-title, .hero-subtitle { margin-bottom: 15px; }
        .hero-customers { margin-bottom: 25px; }
        .customer-label { font-size: .9rem; }
        .hero-booking-btn { padding: 10px 24px; font-size: 1rem; }
        .weekly-booking-modal .modal-header, .weekly-booking-modal .modal-body { padding-left: 20px; padding-right: 20px; }
        .weekly-booking-modal .modal-footer { padding-left: 20px; padding-right: 20px; }
        .schedule-section { padding-top: 48px; padding-bottom: 56px; }
        .schedule-header { display: block; }
        .schedule-filters { margin-top: 20px; }
        .schedule-filters label { flex: 1 1 160px; }
        .schedule-card-heading { display: block; }
        .schedule-actions { flex-wrap: wrap; margin-top: 12px; }
        .schedule-status { display: inline-block; margin-top: 12px; }
    }
</style>

<script>
    const counter = document.querySelector(".customer-number");

    if (counter) {
        const target = Number(counter.dataset.target);

        const duration = 1500;
        const delay = 800;

        setTimeout(() => {
            const startTime = performance.now();

            function updateCounter(currentTime) {
                const elapsed = currentTime - startTime;

                const progress = Math.min(elapsed / duration, 1);

                const easeOut = 1 - Math.pow(1 - progress, 3);

                const currentValue = Math.floor(target * easeOut);

                counter.textContent =
                    currentValue.toLocaleString("vi-VN");

                if (progress < 1) {
                    requestAnimationFrame(updateCounter);
                } else {
                    counter.textContent =
                        target.toLocaleString("vi-VN");
                }
            }

            requestAnimationFrame(updateCounter);
        }, delay);
    }
</script>
