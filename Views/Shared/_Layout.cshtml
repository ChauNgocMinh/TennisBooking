<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TennisBooking</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TennisBooking.styles.css" asp-append-version="true" />
</head>
<body>
    <header id="siteHeader" class="site-header">
        <nav class="navbar navbar-expand-lg site-navbar">
            <div class="container">

                <a class="navbar-brand d-flex align-items-center"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    <img src="~/media/Logo.png"
                         alt="TennisBooking"
                         height="45"
                         class="d-inline-block align-text-top">
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center gap-lg-2">

                        <li class="nav-item">
                            <a class="nav-link active"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                <span data-i18n="nav.home">Trang chủ</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Coach"
                               asp-action="Index">
                                <span data-i18n="nav.coaches">Huấn luyện viên</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="News"
                               asp-action="Index">
                                <span data-i18n="nav.news">Tin tức</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="About">
                                <span data-i18n="nav.about">Về chúng tôi</span>
                            </a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle"
                               href="#"
                               id="languageDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                VN
                            </a>

                            <ul class="dropdown-menu dropdown-menu-end"
                                aria-labelledby="languageDropdown">

                                <li>
                                    <a class="dropdown-item"
                                       href="#"
                                       data-language="vi">
                                        <span data-i18n="language.vietnamese">VN</span>
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       href="#"
                                       data-language="en">
                                        <span data-i18n="language.english">ENG</span>
                                    </a>
                                </li>
                            </ul>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container site-footer-grid">
            <div>
                <a class="site-footer-brand" asp-controller="Home" asp-action="Index">
                    ACE TENNIS ACADEMY
                </a>
                <p data-i18n="footer.tagline">Nơi kết nối đam mê tennis.</p>
            </div>

            <div>
                <h2 data-i18n="footer.explore">Khám phá</h2>
                <a asp-controller="Coach" asp-action="Index" data-i18n="nav.coaches">
                    Huấn luyện viên
                </a>
                <a asp-controller="Home" asp-action="About" data-i18n="nav.about">
                    Về chúng tôi
                </a>
                <a asp-controller="Home" asp-action="Privacy" data-i18n="footer.privacy">
                    Chính sách bảo mật
                </a>
            </div>

            <div>
                <h2>VĂN PHÒNG GIAO DỊCH</h2>
                <span>
                    45 Ngô Quang Huy, phường Thảo Điền,<br>
                    TP. Thủ Đức, TP. HCM
                </span>

                <h2>CLB TENNIS ACE SPORT</h2>
                <span>
                    Đường 18 Khu đô thị Vạn Phúc,<br>
                    phường Hiệp Bình Phước, TP. Thủ Đức, TP.HCM
                </span>

                <a href="tel:+84909000080">📱 0909.000.080 - 0819.909.000</a>
                <a href="http://acesport.net">🌐 http://acesport.net</a>
                <a href="mailto:acesportcorp@gmail.com">✉️ acesportcorp@gmail.com</a>
                <a href="https://www.facebook.com/ACEsportcorp">ⓕ ACEsportcorp</a>
            </div>
        </div>

        <div class="container site-footer-bottom">
            <span>&copy; 2026 ACE Tennis Academy</span>
            <span data-i18n="footer.rights">Bảo lưu mọi quyền.</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/booking-week.js" asp-append-version="true"></script>
    <script src="~/js/booking-validation.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
<script>
    const header = document.getElementById("siteHeader");

    function handleHeaderScroll() {
    if (window.scrollY > 80) {
    header.classList.add("header-scrolled");
    } else {
    header.classList.remove("header-scrolled");
    }
    }

    window.addEventListener("scroll", handleHeaderScroll);

    handleHeaderScroll();
</script>
