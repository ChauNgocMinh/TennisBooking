@model AdminNewsViewModel

<div class="admin-news-form">
    <div class="admin-form-intro">
        <div>
            <h1 data-i18n="admin.newsForm">News details</h1>
        </div>
    </div>

    <form asp-action="Save" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="BannerImageUrl" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <section class="admin-form-section">
            <div class="admin-form-section-heading">
                <div>
                    <h2 data-i18n="admin.storyBasics">Story basics</h2>
                </div>
            </div>
            <div class="admin-form-grid">
                <div class="admin-field admin-short-content-field">
                    <label asp-for="TitleVi" data-i18n="admin.titleVi">Vietnamese title</label>
                    <input asp-for="TitleVi" />
                    <span asp-validation-for="TitleVi" class="text-danger"></span>
                </div>
                <div class="admin-field admin-short-content-field">
                    <label asp-for="TitleEn" data-i18n="admin.titleEn">English title</label>
                    <input asp-for="TitleEn" />
                    <span asp-validation-for="TitleEn" class="text-danger"></span>
                </div>
                <div class="admin-field">
                    <label asp-for="ShortContentVi" data-i18n="admin.shortContentVi">Vietnamese short content</label>
                    <textarea asp-for="ShortContentVi" rows="4"></textarea>
                    <span asp-validation-for="ShortContentVi" class="text-danger"></span>
                </div>
                <div class="admin-field">
                    <label asp-for="ShortContentEn" data-i18n="admin.shortContentEn">English short content</label>
                    <textarea asp-for="ShortContentEn" rows="4"></textarea>
                    <span asp-validation-for="ShortContentEn" class="text-danger"></span>
                </div>
            </div>
        </section>

        <section class="admin-form-section">
            <div class="admin-form-section-heading">
                <div>
                    <h2 data-i18n="admin.visual">Visual</h2>
                    <p data-i18n="admin.visualHint">Choose a banner that gives the story a strong first impression.</p>
                </div>
            </div>
            <div class="admin-form-grid admin-form-grid-visual">
                <div class="admin-field">
                    <label asp-for="BannerImage" data-i18n="admin.bannerImage">Banner image</label>
                    <input asp-for="BannerImage" type="file" accept=".jpg,.jpeg,.png,.webp,.gif" />
                    <small data-i18n="admin.bannerHint">JPG, PNG, WEBP or GIF, up to 5 MB.</small>
                    <span asp-validation-for="BannerImage" class="text-danger"></span>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.BannerImageUrl))
            {
                <div class="admin-existing-image">
                    <img src="@Model.BannerImageUrl" alt="" />
                    <span data-i18n="admin.currentBanner">Current banner</span>
                </div>
            }
        </section>

        <section class="admin-form-section">
            <div class="admin-form-section-heading">
                <div>
                    <h2 data-i18n="admin.storyContent">Story content</h2>
                </div>
            </div>
            <div class="admin-editor-language"><span data-i18n="admin.contentVi">Vietnamese content</span><b>VI</b></div>
            <partial name="_RichTextEditor" model="new RichTextEditorViewModel { FieldName = nameof(Model.ContentVi), Html = Model.ContentVi }" />
            <div class="admin-editor-language"><span data-i18n="admin.contentEn">English content</span><b>EN</b></div>
            <partial name="_RichTextEditor" model="new RichTextEditorViewModel { FieldName = nameof(Model.ContentEn), Html = Model.ContentEn }" />
        </section>

        <div class="admin-form-actions">
            <a asp-action="Index" data-i18n="admin.cancel">Cancel</a>
            <button class="admin-primary" type="submit" data-i18n="admin.save">Save story</button>
        </div>
    </form>
</div>
