@model AdminPagedViewModel<AdminNewsViewModel>

@{
    ViewData["Title"] = "Tin tức";
}
<div class="admin-page-header">
    <h1>Tin tức</h1>
    <a class="admin-primary" asp-action="Create">Thêm bài viết</a>
</div>
<div class="admin-table-wrap">
    <table class="table admin-table">
        <thead>
                <tr>
                <th></th>
                <th>Tiêu đề tiếng Việt</th>
                <th>Tiêu đề tiếng Anh</th>
                <th>Ngày đăng</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        <img class="admin-table-image admin-table-banner" src="@item.BannerImageUrl" alt="" loading="lazy" onerror="this.onerror=null;this.src='/media/Logo.png';" />
                    </td>
                    <td>@item.TitleVi</td>
                    <td>@item.TitleEn</td>
                    <td>@item.PublishedAt.ToString("dd/MM/yyyy")</td>
                    <td class="admin-actions">
                        <a class="admin-action-edit" asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                        <form asp-action="Delete" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <button class="admin-action-delete" type="submit">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<partial name="_Pagination" model="Model.Pagination" />
