@model AdminCoachViewModel

<div class="admin-form-card">
    <h1>Thông tin huấn luyện viên</h1>
    <form asp-action="Save" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="ImageUrl" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="admin-form-grid">
            <div class="admin-field">
                <label asp-for="Name">Họ tên</label>
                <input asp-for="Name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="admin-field">
                <label asp-for="ImageFile">Ảnh huấn luyện viên</label>
                <input asp-for="ImageFile" type="file" accept=".jpg,.jpeg,.png,.webp,.gif" />
                <small>JPG, PNG, WEBP hoặc GIF, tối đa 5 MB.</small>
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>
            <div class="admin-field">
                <label asp-for="Experience">Kinh nghiệm</label>
                <input asp-for="Experience" />
                <span asp-validation-for="Experience" class="text-danger"></span>
            </div>
            <div class="admin-field">
                <label asp-for="Certificates">Chứng chỉ</label>
                <input asp-for="Certificates" />
                <span asp-validation-for="Certificates" class="text-danger"></span>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <div class="admin-existing-image">
                <img src="@Model.ImageUrl" alt="" />
                <span>Ảnh hiện tại</span>
            </div>
        }

        <div class="admin-field">
            <label asp-for="Achievements">Thành tựu</label>
            <input asp-for="Achievements" />
            <span asp-validation-for="Achievements" class="text-danger"></span>
        </div>

        <label>Giới thiệu</label>
        <partial name="_RichTextEditor" model="new RichTextEditorViewModel { FieldName = nameof(Model.IntroductionHtml), Html = Model.IntroductionHtml }" />

        <div class="admin-form-actions">
            <a asp-action="Index">Hủy</a>
            <button class="admin-primary" type="submit">Lưu</button>
        </div>
    </form>
</div>
