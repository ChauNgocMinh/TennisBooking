@model AdminPagedViewModel<AdminCoachViewModel>

@{ ViewData["Title"] = "Huấn luyện viên"; }

<div class="admin-page">
    <div class="admin-page-header">
        <h1>Huấn luyện viên</h1>
        <a class="admin-primary" asp-action="Create">Thêm huấn luyện viên</a>
    </div>

    <div class="admin-surface">
        <table class="table admin-table">
            <thead>
                <tr>
                    <th></th>
                    <th>Họ tên</th>
                    <th>Kinh nghiệm</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <img class="admin-table-image" src="@item.ImageUrl" alt="" loading="lazy" onerror="this.onerror=null;this.src='/media/Logo.png';" />
                        </td>
                        <td>@item.Name</td>
                        <td>@item.Experience</td>
                        <td class="admin-actions">
                            <a class="admin-action-edit" asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                            <form asp-action="Delete" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button class="admin-action-delete" type="submit">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" model="Model.Pagination" />
</div>
