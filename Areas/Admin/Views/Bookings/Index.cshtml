@model IReadOnlyCollection<TennisBooking.ViewModels.AdminBookingViewModel>

@{ ViewData["Title"] = "Bookings"; }

<div class="admin-page">
    <div class="admin-page-header">
        <h1 data-i18n="admin.bookings">Bookings</h1>
    </div>

    <div class="admin-surface">
        <table class="table admin-table">
            <thead>
                <tr>
                    <th data-i18n="admin.court">Court</th>
                    <th data-i18n="admin.customer">Customer</th>
                    <th data-i18n="admin.phone">Phone</th>
                    <th data-i18n="admin.start">Start</th>
                    <th data-i18n="admin.end">End</th>
                    <th data-i18n="admin.status">Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CourtName</td>
                        <td>@item.CustomerName</td>
                        <td>@item.PhoneNumber</td>
                        <td>@item.StartTime.ToString("g")</td>
                        <td>@item.EndTime.ToString("g")</td>
                        <td data-i18n="admin.status.@item.Status">@item.Status</td>
                        <td class="admin-actions">
                            @if (item.Status == TennisBooking.Common.Enum.BookingStatus.Pending)
                            {
                                <form asp-action="Confirm" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" data-i18n="admin.confirm">Confirm</button>
                                </form>
                                <form asp-action="Cancel" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" data-i18n="admin.cancel">Cancel</button>
                                </form>
                            }
                            else if (item.Status == TennisBooking.Common.Enum.BookingStatus.Confirmed)
                            {
                                <form asp-action="Cancel" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" data-i18n="admin.cancel">Cancel</button>
                                </form>
                                <form asp-action="SetPending" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" data-i18n="admin.setPending">Set Pending</button>
                                </form>
                            }
                            else if (item.Status == TennisBooking.Common.Enum.BookingStatus.Cancelled)
                            {
                                <form asp-action="SetPending" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" data-i18n="admin.setPending">Set Pending</button>
                                </form>
                            }

                            <form asp-action="Delete" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" data-i18n="admin.delete">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
