@model AdminLoginViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Đăng nhập quản trị";
}
<div class="admin-login-card">
    <p class="admin-kicker">ACE TENNIS ACADEMY</p>
    <h1>Đăng nhập quản trị</h1>
    <p>Đăng nhập để quản lý học viện tennis.</p>
    <form asp-action="Login" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="ReturnUrl" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <label asp-for="Email">Email</label>
        <input asp-for="Email" autocomplete="username" />
        <span asp-validation-for="Email" class="text-danger"></span>
        <label asp-for="Password">Mật khẩu</label>
        <input asp-for="Password" autocomplete="current-password" />
        <span asp-validation-for="Password" class="text-danger"></span>
        <button class="admin-primary" type="submit">Đăng nhập</button>
    </form>
</div>
