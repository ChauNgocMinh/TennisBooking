<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ACE Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-shell">
    <div class="admin-body">
        <aside id="adminSidebar" class="admin-sidebar">
            <a class="admin-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">ACE ADMIN</a>
            <nav>
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Tổng quan</a>
                <a asp-area="Admin" asp-controller="Courts" asp-action="Index">Sân tennis</a>
                <a asp-area="Admin" asp-controller="Coaches" asp-action="Index">Huấn luyện viên</a>
                <a asp-area="Admin" asp-controller="News" asp-action="Index">Tin tức</a>
                <a asp-area="Admin" asp-controller="Bookings" asp-action="Index">Đặt lịch</a>
            </nav>
            <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button class="admin-logout" type="submit">Đăng xuất</button>
            </form>
        </aside>
        <main class="admin-content">
        <header class="admin-toolbar">
            <button class="admin-menu-toggle" type="button" aria-controls="adminSidebar" aria-expanded="false">
                <span aria-hidden="true">☰</span>
                <span class="visually-hidden">Mở menu quản trị</span>
            </button>
            <div class="admin-toolbar-heading">
                <strong>Bảng quản trị</strong>
                <span class="admin-user">@User.Identity?.Name</span>
            </div>
        </header>
        <div class="admin-content-inner">
            @if (TempData["AdminError"] is string adminError)
            {
                <div class="alert alert-warning">@adminError</div>
            }
            @RenderBody()
        </div>
        </main>
    </div>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    <script src="~/js/admin-rich-text.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
