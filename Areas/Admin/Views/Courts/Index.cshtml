@model AdminPagedViewModel<AdminCourtViewModel>

@{ ViewData["Title"] = "Sân tennis"; }

<div class="admin-page">
    <div class="admin-page-header">
        <h1>Sân tennis</h1>
        <a class="admin-primary" asp-action="Create">Thêm sân</a>
    </div>

    <div class="admin-surface">
        <table class="table admin-table">
            <thead>
                <tr>
                    <th>Tên sân</th>
                    <th>Loại sân</th>
                    <th>Giá</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.CourtType</td>
                        <td>@item.Price.ToString("N0")</td>
                        <td class="admin-actions">
                            <a class="admin-action-edit" asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                            <form asp-action="Delete" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button class="admin-action-delete" type="submit">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" model="Model.Pagination" />
</div>
