@model AdminCourtViewModel

<div class="admin-form-card">
    <h1>Thông tin sân</h1>
    <form asp-action="Save" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="admin-form-grid">
            <div class="admin-field">
                <label asp-for="Name">Tên sân</label>
                <input asp-for="Name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="admin-field">
                <label asp-for="CourtType">Loại sân</label>
                <input asp-for="CourtType" />
                <span asp-validation-for="CourtType" class="text-danger"></span>
            </div>
            <div class="admin-field">
                <label asp-for="Price">Giá</label>
                <input asp-for="Price" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
        </div>

        <div class="admin-field">
            <label asp-for="Description">Mô tả</label>
            <textarea asp-for="Description" rows="5"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="admin-form-actions">
            <a asp-action="Index">Hủy</a>
            <button class="admin-primary" type="submit">Lưu</button>
        </div>
    </form>
</div>
